# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Local admin fallback auth (active ONLY when Clerk is not configured)
ADMIN_USERNAME=changeme
ADMIN_PASSWORD_HASH=$2b$12$CHANGEME
JWT_SECRET=change-me-to-a-long-random-secret

# CORS (comma separated)
CORS_ORIGINS=https://cms.serviciospinamar.com,https://serviciospinamar.com

# MinIO / S3-compatible storage
S3_ENDPOINT_URL=https://s3.qeva.xyz
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=serviciospinamar-fotos
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=https://s3.qeva.xyz/serviciospinamar-fotos

# Clerk (optional). Leave empty to use the local admin fallback.
# When CLERK_ISSUER_URL + (CLERK_JWKS_URL or CLERK_SIGNING_KEYS) are set,
# Clerk JWT verification activates automatically and /api/admin/login is disabled.
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
CLERK_SIGNING_KEYS=
