# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Admin auth
ALLOW_GMAIL=admin@example.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/admin/google/callback
ADMIN_LOGIN_REDIRECT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-secret

# CORS (comma separated)
CORS_ORIGINS=https://cms.serviciospinamar.com,https://serviciospinamar.com

# MinIO / S3-compatible storage
S3_ENDPOINT_URL=https://s3.qeva.xyz
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=serviciospinamar-fotos
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=https://s3.qeva.xyz/serviciospinamar-fotos
