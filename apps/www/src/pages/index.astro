---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Feature from '../components/Feature.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { whatsapp } from '../data/service-pages';

const services = [
  { title: 'Pintores en Pinamar', description: 'Pintura interior y exterior de casas y comercios en Pinamar, con materiales adecuados para el clima costero.', image: '/images/servicio-pintura.webp', href: '/servicios/pintura/', ariaLabel: 'Ver servicio de pintores en Pinamar' },
  { title: 'Hidrolavado', description: 'Hidrolavado de fachadas, techos, veredas, decks, patios, pisos y muros en Pinamar, Cariló, Valeria del Mar y Ostende.', image: '/images/servicio-hidrolavado.webp', href: '/servicios/hidrolavado/', ariaLabel: 'Ver servicio de hidrolavado en Pinamar' },
  { title: 'Plomero en Pinamar', description: 'Servicio de plomería en Pinamar para instalaciones, reparaciones, pérdidas de agua y mantenimiento general.', image: '/images/servicio-plomeria.webp', href: '/servicios/plomeria/', ariaLabel: 'Ver servicio de plomero en Pinamar' },
  { title: 'Gasista en Pinamar', description: 'Revisión, reparación e instalación de artefactos de gas en casas y comercios de Pinamar.', image: '/images/servicio-gas.webp', href: '/servicios/gas/', ariaLabel: 'Ver servicio de gasista en Pinamar' }
];
const faqs = [
  ['¿Realizan presupuestos en Pinamar?', 'Sí. Realizamos presupuestos para trabajos de pintura, hidrolavado, plomería, gas y mantenimiento general en Pinamar. Podemos coordinar una visita o recibir fotos y videos por WhatsApp.'],
  ['¿Trabajan con propiedades cerradas?', 'Sí. Brindamos mantenimiento para casas cerradas y propiedades de vacaciones. Coordinamos las reparaciones necesarias y enviamos fotografías o videos del avance.'],
  ['¿Atienden inmobiliarias y administradores?', 'Sí. Trabajamos con inmobiliarias, administradores y propietarios que necesitan mantenimiento, reparaciones y puesta a punto de propiedades de alquiler.'],
  ['¿Qué zonas cubren?', 'Trabajamos en Pinamar, Cariló, Valeria del Mar y Ostende.'],
  ['¿Realizan pintura interior y exterior?', 'Sí. Realizamos pintura interior y exterior de casas, departamentos, comercios, fachadas, paredes y techos.'],
  ['¿Qué superficies pueden hidrolavar?', 'Realizamos hidrolavado de fachadas, techos, patios, veredas, decks, muros y pisos exteriores.'],
  ['¿Puedo pedir presupuesto por WhatsApp?', 'Sí. Podés enviarnos fotos o videos del trabajo por WhatsApp para realizar una primera evaluación y coordinar una visita cuando sea necesario.'],
  ['¿Trabajan durante todo el año?', 'Sí. Brindamos servicios de mantenimiento durante todo el año, tanto en temporada como fuera de temporada.']
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': 'https://www.serviciospinamar.com/#faq',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer
    }
  }))
};
---
<BaseLayout title="Mantenimiento de Casas en Pinamar | Pintura, Plomería e Hidrolavado" description="Mantenimiento de casas y propiedades en Pinamar. Servicios de pintura, hidrolavado, plomería y gas en Pinamar, Cariló, Valeria del Mar y Ostende. Pedí presupuesto por WhatsApp." preloadImage="/images/hero-casa-pinamar.webp" structuredData={[faqSchema]}>
  <Header />
  <main>
    <section id="inicio" class="hero">
      <div class="hero-bg"></div>
      <div class="container hero-content">
        <div class="hero-copy">
          <p class="eyebrow">Servicios de mantenimiento en la costa</p>
          <h1>
            <span class="marker-sequence marker-hero-title" data-marker>
              <span class="marker marker-word" style="--word-index:0">Mantenimiento</span>
              <span class="marker marker-word" style="--word-index:1">de</span>
              <span class="marker marker-word" style="--word-index:2">casas</span>
              <span class="marker marker-word" style="--word-index:3">y</span>
              <span class="marker marker-word" style="--word-index:4">propiedades</span>
              <span class="marker marker-word" style="--word-index:5">en</span>
              <span class="marker marker-word" style="--word-index:6">Pinamar</span>
            </span>
          </h1>
          <p class="lead">Mantenimiento de casas y propiedades en Pinamar: pintura, hidrolavado, plomería y gas para casas, comercios e inmobiliarias en Cariló, Valeria del Mar y Ostende.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={19} /> Pedir presupuesto</a>
            <a class="button button-outline" href="#servicios">Ver servicios</a>
          </div>
          <p class="trust"><Icon name="shield" size={23} /> Presupuestos claros y sin compromiso</p>
        </div>
      </div>
      <div class="coverage-pill">Pinamar · Cariló · Valeria del Mar · Ostende</div>
    </section>

    <section id="servicios" class="section services-section">
      <div class="container">
        <header class="section-heading centered"><p class="eyebrow">Nuestros servicios</p><h2><span class="marker-sequence marker-heading" data-marker><span class="marker marker-word" style="--word-index:0">Servicios</span> <span class="marker marker-word" style="--word-index:1">de</span> <span class="marker marker-word" style="--word-index:2">mantenimiento</span> <span class="marker marker-word" style="--word-index:3">para</span> <span class="marker marker-word" style="--word-index:4">casas</span> <span class="marker marker-word" style="--word-index:5">en</span> <span class="marker marker-word" style="--word-index:6">Pinamar</span></span></h2><p>Mantenimiento de casas y propiedades en Pinamar: si buscás pintores, plomero, gasista o hidrolavado en Pinamar, cada servicio tiene su página con alcance y preguntas frecuentes.</p></header>
        <div class="services-grid">{services.map((service) => <ServiceCard {...service} />)}</div>
        <div class="features-grid">
          <Feature icon="shield" title="Profesionales de confianza" text="Trabajos coordinados con alcance claro antes de empezar." />
          <Feature icon="camera" title="Transparencia total" text="Te enviamos fotos del avance y te mantenemos informado." />
          <Feature icon="pin" title="Conocemos la zona" text="Experiencia en mantenimiento de propiedades en Pinamar, Cariló, Valeria del Mar y Ostende." />
          <Feature icon="calendar" title="Disponibilidad todo el año" text="Mantenimiento de casas y comercios durante todo el año, incluso fuera de temporada." />
        </div>
      </div>
    </section>

    <section id="nosotros" class="section about-section">
      <div class="container about-grid">
        <article class="about-copy">
          <p class="eyebrow">Sobre nosotros</p>
          <h2><span class="marker-sequence marker-heading" data-marker>Equipo local de mantenimiento en Pinamar</span></h2>
          <p>Somos un equipo de mantenimiento de propiedades en Pinamar. Trabajamos con propietarios, administradores e inmobiliarias que necesitan pintura, hidrolavado, plomería, gas y reparaciones generales.</p>
          <p>También atendemos casas cerradas o de vacaciones, coordinando los trabajos y enviando fotos y videos del avance por WhatsApp.</p>
          <a class="button button-outline" href="#contacto">Conocer más</a>
        </article>
        <figure class="about-image" data-animate><img src="/images/costa-pinamar.webp" alt="Costa de Pinamar entre dunas y pinos" loading="lazy" /></figure>
        <aside id="contacto" class="contact-card" data-animate>
          <p class="eyebrow">¿Hablamos?</p>
          <h2>Pedí tu presupuesto de mantenimiento en <span class="marker marker-light">Pinamar</span></h2>
          <p>Contanos qué trabajo necesitás. Podemos coordinar una visita o recibir fotos y videos para evaluar pintura, hidrolavado, plomería, gas o reparaciones generales.</p>
          <ul><li><Icon name="check" size={18} /> Comunicación directa por WhatsApp</li><li><Icon name="check" size={18} /> Sin compromiso</li><li><Icon name="check" size={18} /> Coordinamos visita o recibimos fotos y videos</li></ul>
          <a class="button button-light" href={whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={19} /> Solicitar presupuesto por WhatsApp</a>
        </aside>
      </div>
    </section>

    <section id="zonas" class="zones section-small"><div class="container"><p class="eyebrow centered-text">Zonas de cobertura</p><div class="zones-grid"><article data-animate><h3>Pinamar</h3><p>Servicios de mantenimiento, pintura, hidrolavado, plomería y gas para propiedades en Pinamar.</p></article><article data-animate><h3>Cariló</h3><p>Mantenimiento de casas y propiedades en Cariló.</p></article><article data-animate><h3>Valeria del Mar</h3><p>Pintura, hidrolavado, plomería y mantenimiento de propiedades en Valeria del Mar.</p></article><article data-animate><h3>Ostende</h3><p>Servicios de mantenimiento para casas, comercios y propiedades en Ostende.</p></article></div></div></section>

    <section id="faq" class="section faq-section"><div class="container faq-layout"><header class="section-heading"><p class="eyebrow">Preguntas frecuentes</p><h2><span class="marker-sequence marker-heading" data-marker><span class="marker marker-word" style="--word-index:0">Todo</span> <span class="marker marker-word" style="--word-index:1">lo</span> <span class="marker marker-word" style="--word-index:2">que</span> <span class="marker marker-word" style="--word-index:3">necesitás</span> <span class="marker marker-word" style="--word-index:4">saber</span></span></h2></header><div>{faqs.map(([q,a]) => <details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>
  </main>
  <Footer />
  <a class="floating-wa" href={whatsapp} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><Icon name="whatsapp" size={25} /></a>
</BaseLayout>
