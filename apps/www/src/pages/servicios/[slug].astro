---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { getRelatedServices, getServiceUrl, serviceAreas, servicePages, whatsapp, whatsappMessage, whatsappNumber } from '../../data/service-pages';

export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const canonical = getServiceUrl(service.slug);
const relatedServices = getRelatedServices(service.slug);
const credentialWhatsapp = 'credential' in service && service.credential
  ? `${whatsappNumber}?text=${encodeURIComponent(whatsappMessage(service.slug === 'plomeria' ? 'plomería' : service.slug))}`
  : undefined;

const baseUrl = 'https://www.serviciospinamar.com';
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: baseUrl },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${baseUrl}/servicios/` },
    { '@type': 'ListItem', position: 3, name: service.shortName, item: canonical }
  ]
};

const serviceSchema = {
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: service.serviceType,
  serviceType: service.serviceType,
  description: service.description,
  url: canonical,
  provider: { '@id': 'https://www.serviciospinamar.com/#localbusiness' },
  areaServed: serviceAreas.map((area) => ({
    '@type': 'AdministrativeArea',
    name: area
  })),
  offers: {
    '@type': 'Offer',
    url: canonical,
    itemOffered: {
      '@type': 'Service',
      name: service.serviceType
    }
  }
};

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: service.faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer
    }
  }))
};

const subtypeSchemas = 'subtypes' in service && service.subtypes
  ? service.subtypes.map((subtype) => ({
      '@type': 'Service',
      '@id': `${canonical}#service-${subtype.slug}`,
      name: subtype.name,
      serviceType: subtype.name,
      description: subtype.description,
      url: `${canonical}#${subtype.slug}`,
      provider: { '@id': 'https://www.serviciospinamar.com/#localbusiness' },
      areaServed: serviceAreas.map((area) => ({
        '@type': 'AdministrativeArea',
        name: area
      }))
    }))
  : [];

const structuredData = [serviceSchema, ...subtypeSchemas, faqSchema, breadcrumbSchema];

---
<BaseLayout title={service.title} description={service.description} canonical={canonical} preloadImage={service.image} structuredData={structuredData}>
  <Header />
  <main class="service-page">
    <section class="service-hero">
      <div class="service-hero__grain" aria-hidden="true"></div>
      <div class="container service-hero__grid">
        <div class="service-hero__copy">
          <a class="service-back" href="/servicios/"><Icon name="arrow" size={17} /> Volver a servicios</a>
          <p class="eyebrow">{service.eyebrow}</p>
          <h1><span class="marker-sequence marker-hero-title" data-marker>{service.h1}</span></h1>
          <p class="lead">{service.lead}</p>
          <div class="hero-actions">
            <a class="button button-primary" href={whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={19} /> Pedir presupuesto</a>
            <a class="button button-outline" href="#alcance">Ver alcance</a>
          </div>
        </div>
        <figure class="service-hero__image" data-animate>
          <div class="service-hero__image-frame">
            <img src={service.image} alt={service.imageAlt} width="1122" height="1402" fetchpriority="high" decoding="async" />
            <figcaption>{service.intent} · Pinamar, Cariló, Valeria del Mar y Ostende</figcaption>
          </div>
          <a class="button button-primary service-hero__works-cta" href={`/trabajos/?service=${service.slug}`}><Icon name="arrow" size={18} /> Ver trabajos realizados</a>
        </figure>
      </div>
    </section>

    <section id="alcance" class="section service-intro">
      <div class="container">
        <div class="service-intro__panel" data-animate>
          <div class="service-intro__copy">
            <header class="section-heading">
              <p class="eyebrow">Qué incluye</p>
              <h2>Un servicio claro para resolver lo que necesita tu propiedad</h2>
            </header>
            {'credential' in service && service.credential && credentialWhatsapp && (
              <aside class="service-credential" aria-label={`Matrícula y habilitación de ${service.credential.name}`}>
                <div class="service-credential__body">
                  <p class="eyebrow service-credential__eyebrow">Responsable técnico</p>
                  <h3>{service.credential.name}</h3>
                  <span class="service-credential__rule" aria-hidden="true"></span>
                  <p>{service.credential.description}</p>
                  {service.credential.items.length > 0 && (
                    <ul class="service-credential__meta">
                      {service.credential.items.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                </div>
                <a class="button button-primary service-credential__cta" href={credentialWhatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Consultar por WhatsApp</a>
              </aside>
            )}
          </div>
          <div class="service-list-panel">
            <ul>
              {service.covers.map((item) => <li><Icon name="check" size={18} /> {item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {'sections' in service && service.sections && (
      <section class="section" style="padding-top: 0;">
        <div class="container">
          <nav class="service-anchor-nav" aria-label="Secciones de este servicio">
            {service.sections.map((section) => <a href={`#${section.slug}`}>{section.title}</a>)}
          </nav>
        </div>
      </section>
    )}

    {'sections' in service && service.sections && service.sections.map((section) => (
      <section id={section.slug} class="section">
        <div class="container">
          <header class="section-heading">
            <p class="eyebrow">{section.eyebrow}</p>
            <h2>{section.title}</h2>
          </header>
          <div class="service-anchor-section__copy">
            {section.body.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => <li><Icon name="check" size={18} /> {bullet}</li>)}
              </ul>
            )}
            {'link' in section && section.link && (
              <p><a href={section.link.href} target="_blank" rel="noopener">{section.link.label}</a></p>
            )}
          </div>
        </div>
      </section>
    ))}

    <section class="section service-process">
      <div class="container service-process__grid">
        <header class="section-heading">
          <p class="eyebrow">Cómo trabajamos</p>
          <h2>Del primer mensaje al trabajo coordinado</h2>
          <p>El objetivo es que tengas alcance, tiempos y próximos pasos claros antes de avanzar.</p>
        </header>
        <ol class="process-list">
          {service.process.map((item, index) => <li data-animate><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="zones section-small"><div class="container"><p class="eyebrow centered-text">Zonas de cobertura</p><div class="zones-grid">{serviceAreas.map((area) => <article data-animate><h3>{area}</h3><p>{service.shortName} para propiedades en {area}.</p></article>)}</div></div></section>

    <section id="faq" class="section faq-section"><div class="container faq-layout"><header class="section-heading"><p class="eyebrow">Preguntas frecuentes</p><h2>Consultas sobre {service.shortName} en Pinamar</h2></header><div>{service.faqs.map(([q, a]) => <details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div></section>

    <section class="section service-related">
      <div class="container">
        <header class="section-heading centered"><p class="eyebrow">También puede servirte</p><h2>Otros servicios en Pinamar</h2></header>
        <div class="related-grid">
          {relatedServices.map((item) => <a href={`/servicios/${item.slug}/`} data-animate><span>{item.shortName}</span><Icon name="arrow" size={18} /></a>)}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <a class="floating-wa" href={whatsapp} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><Icon name="whatsapp" size={25} /></a>
</BaseLayout>
