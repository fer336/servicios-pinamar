---
import WorkCarousel from './WorkCarousel';
import type { TrabajoItem } from '../data/trabajos/api';

interface Props {
  data: TrabajoItem[];
  hasMore?: boolean;
  service?: string;
  title?: string;
}

const {
  data,
  hasMore = false,
  service,
  title
} = Astro.props;
---

<section class="work-grid-section" data-work-gallery data-has-more={hasMore ? 'true' : 'false'} data-service={service ?? ''} aria-label="Trabajos realizados">
  {title && <h3 class="work-grid__title">{title}</h3>}
  <script is:inline type="application/json" data-work-data set:html={JSON.stringify(data)}></script>
  <WorkCarousel client:load initialItems={data} initialHasMore={hasMore} service={service} />
</section>
