---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { whatsapp } from '../data/service-pages';
---
<header class="site-header">
  <div class="nav-shell container">
    <Logo />
    <nav class="site-nav" aria-label="Navegación principal">
      <button class="menu-button" type="button" popovertarget="main-menu" aria-controls="main-menu" aria-label="Abrir menú"><Icon name="menu" /></button>
      <div id="main-menu" class="nav-menu" popover="auto">
        <a href="/servicios/">Servicios</a>
        <a href="/trabajos/">Trabajos</a>
        <a href="/nosotros/">Sobre nosotros</a>
        <a href="/zonas/">Zonas de cobertura</a>
        <a href="/contacto/">Contacto</a>
      </div>
    </nav>
    <a class="nav-wa" href={whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Escribir por WhatsApp</a>
  </div>
</header>
<script>
  // The collapsed menu is a native popover: the button opens it declaratively, and Esc or a tap outside closes it.
  // Wide layouts show the same list inline through CSS, so no script is needed to render the navigation.
  const menu = document.querySelector<HTMLElement>('#main-menu');
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const supportsPopover = Object.hasOwn(HTMLElement.prototype, 'popover');
  const close = () => {
    if (!menu) return;
    if (supportsPopover) {
      if (menu.matches(':popover-open')) menu.hidePopover();
    } else menu.classList.remove('is-open');
  };
  if (menu && button && !supportsPopover) {
    // Browsers without the Popover API (older iOS): toggle a class instead.
    button.addEventListener('click', () => menu.classList.toggle('is-open'));
  }
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
  // Leaving the collapsed layout with the menu open would keep it floating in the top layer.
  matchMedia('(min-width: 1051px)').addEventListener('change', (event) => event.matches && close());
</script>
