---
import { journeyStops } from '../data/home-journey';
import { whatsapp } from '../data/service-pages';
import { partnerNote } from '../data/partner-copy';
import threeUrl from '../vendor/home-journey/three.min.js?url';
import crewUrl from '../vendor/home-journey/crew.js?url';
import tradesUrl from '../scene/trades-crew.js?url';
import sceneUrl from '../scene/house-scene.js?url';
import '../styles/home-journey.css';

const lead = 'Mantenimiento de casas y propiedades en Pinamar: pintura, hidrolavado, plomería, gas, fumigaciones, jardinería, herrería, durlock y carpintería para casas, comercios e inmobiliarias de Pinamar. También trabajamos en Cariló, Valeria del Mar, Ostende y el resto de la costa.';
// Line icons for the service dock (24px grid, stroked with currentColor). The three herrería stops share the hammer.
const icons: Record<string, string> = {
  pintura: '<rect x="4" y="3" width="14" height="6" rx="1.5"/><path d="M18 6h2v5h-8v3"/><rect x="10.5" y="14" width="3" height="7" rx="1"/>',
  hidrolavado: '<path d="M12 3c3 4 6 7.2 6 10.5a6 6 0 0 1-12 0C6 10.2 9 7 12 3z"/><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5"/>',
  plomeria: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.1l-5.8 5.8a1.8 1.8 0 0 0 2.6 2.6l5.8-5.8a4 4 0 0 0 5.1-5.4l-2.6 2.6-2.3-.4-.4-2.3z"/>',
  gas: '<path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2.2 1-3.7 2.3-5 .2 1.6 1 2.6 2.2 3C11 8.5 11 6 12 3z"/>',
  fumigaciones: '<ellipse cx="12" cy="13.5" rx="4" ry="5.5"/><path d="M12 8v11M9.5 5.5 12 8l2.5-2.5M8 11H4.5M8 15H4.5M16 11h3.5M16 15h3.5"/>',
  jardineria: '<path d="M12 3 7 10h3l-4 6h12l-4-6h3z"/><path d="M12 16v5"/>',
  herreria: '<path d="M13.5 3.5 20 10l-2.6 2.6-6.5-6.5z"/><path d="m13.3 8.6-9 9a1.8 1.8 0 0 0 2.6 2.6l9-9"/>',
  durlock: '<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M12 3v18"/><path d="M14.5 7h.01M14.5 12h.01M14.5 17h.01"/>',
  electricidad: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>',
  carpinteria: '<rect x="3" y="4.5" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="15.5" width="18" height="4" rx="1"/>'
};
const iconFor = (id: string) => icons[id.startsWith('herreria') ? 'herreria' : id];
---
<section id="inicio" class="hj" data-stops={JSON.stringify(journeyStops)} data-scripts={JSON.stringify([threeUrl, crewUrl, tradesUrl, sceneUrl])}>
  <div class="journey">
    <div class="stage">
      <div id="viewer">
        <div class="sky" aria-hidden="true"><div class="sun"></div><div class="beams"></div><div class="forest"><i class="f1"></i><i class="f2"></i><i class="f3"></i><b class="floor"></b></div><i class="cloud c1"></i><i class="cloud c2"></i><i class="cloud c3"></i></div>
        <div class="frame"><span class="viewLabel" aria-live="polite">Vista general</span><button id="reset" type="button" hidden>↺ Vista general</button></div>
        <button id="enterTour" class="enterTour" type="button">Recorrer en 3D <span aria-hidden="true">→</span></button>
        <div id="visual" role="img" aria-label="Casa costera con deck, jardín y pinos en tres dimensiones">
          <img class="poster" src="/images/home-journey-poster.webp" alt="" width="903" height="551" fetchpriority="high" decoding="async" />
        </div>
        <div class="viewFoot"><span>Casa en el bosque</span><span>Pinamar · Cariló · Valeria del Mar · Ostende</span></div>
      </div>
      <div class="sheet">
        <button class="sheetHandle" type="button" aria-expanded="false" aria-label="Ver más información"><span></span></button>
        <div class="copy">
          <span class="hj-eyebrow"><i></i> Servicios de mantenimiento en la costa</span>
          <h1>Mantenimiento de casas y propiedades <em>en Pinamar</em></h1>
          <h2 id="chapterName" hidden></h2>
          <p id="lead" class="lead">{lead}</p>
          <div class="workState"><span id="actionStatus" role="status"></span><button id="replay" type="button" aria-label="Repetir la demostración del servicio">↻ Repetir</button></div>
          <a id="serviceLink" class="serviceLink" href={journeyStops[0].href}>Más sobre pintura →</a>
          <a id="quote" class="pill" href={whatsapp} target="_blank" rel="noopener">Consultar por WhatsApp ↗</a>
          <p class="partner-note">{partnerNote}</p>
          <span class="hint">Tocá la casa para recorrer los servicios en 3D</span>
        </div>
        <div class="chooser" id="explorar">
          <span id="progress">Explorar por servicio</span>
          <div class="stepNav" aria-label="Recorrer servicios"><button id="previousService" type="button" aria-label="Servicio anterior" disabled>←</button><button id="nextService" type="button" aria-label="Servicio siguiente">→</button></div>
          <div id="choices" role="group" aria-label="Elegí un servicio">
            {journeyStops.map((stop) => (
              <a href={stop.href} aria-current="false" data-group={stop.id.startsWith('herreria') ? 'herreria' : undefined} title={stop.service}>
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={iconFor(stop.id)} /><i class="dot" aria-hidden="true"></i><span class="lbl">{stop.service}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  import '../scripts/home-journey.js';
</script>
