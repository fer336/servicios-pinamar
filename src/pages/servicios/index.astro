---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { servicePages, whatsapp } from '../../data/service-pages';

const baseUrl = 'https://www.serviciospinamar.com';
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: baseUrl },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${baseUrl}/servicios/` }
  ]
};
---
<BaseLayout title="Servicios de Mantenimiento en Pinamar | Pintura, Hidrolavado, Plomería y Gas" description="Servicios de mantenimiento de propiedades en Pinamar: pintura, hidrolavado, plomería y gas. Pedí presupuesto por WhatsApp." structuredData={[breadcrumbSchema]}>
  <Header />
  <main>
    <section class="section services-listing">
      <div class="container">
        <header class="section-heading centered">
          <p class="eyebrow">Servicios de mantenimiento</p>
          <h1><span class="marker-sequence marker-heading" data-marker>Servicios de mantenimiento en Pinamar</span></h1>
          <p class="lead">Ofrecemos pintura, hidrolavado, plomería y gas para casas, comercios e inmobiliarias en Pinamar, Cariló, Valeria del Mar y Ostende.</p>
        </header>
        <div class="section-heading centered" style="margin-inline: auto;">
          <p>Si necesitás <a href="/servicios/pintura/">pintores en Pinamar</a>, <a href="/servicios/plomeria/">plomero en Pinamar</a>, <a href="/servicios/gas/">gasista en Pinamar</a> o <a href="/servicios/hidrolavado/">hidrolavado en Pinamar</a>, estas páginas explican el alcance de cada servicio sin duplicar contenido por localidad.</p>
        </div>
        <div class="services-grid">
          {servicePages.map((service) => (
            <article class="service-card" style={`--service-image:url('${service.image}')`} data-animate>
              <div class="service-card__bg"></div>
              <div class="service-card__shade"></div>
              <div class="service-card__content">
                <span class="service-icon"><Icon name="check" size={21} /></span>
                <div>
                  <h3>{service.shortName}</h3>
                  <p>{service.description}</p>
                  <a href={`/servicios/${service.slug}/`} aria-label={`Ver servicio de ${service.shortName.toLowerCase()} en Pinamar`}><Icon name="arrow" size={19} /></a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="centered-text" style="margin-top: 3rem;">
          <a class="button button-primary" href={whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" size={19} /> Pedir presupuesto por WhatsApp</a>
        </div>
        <section class="section-small" style="padding-bottom: 0;">
          <div class="service-band">
            <div>
              <p class="eyebrow">Cómo elegir</p>
              <h2>Consultá según el problema visible de la propiedad</h2>
            </div>
            <div class="service-situation-grid">
              <article><p>Si el exterior está opaco, manchado o con verdín, revisá <a href="/servicios/hidrolavado/">hidrolavado en Pinamar</a>.</p></article>
              <article><p>Si hay desgaste de paredes, frentes o interiores, revisá <a href="/servicios/pintura/">pintura en Pinamar</a>.</p></article>
              <article><p>Si aparece una pérdida, humedad o problema de agua, revisá <a href="/servicios/plomeria/">plomería en Pinamar</a>.</p></article>
              <article><p>Si necesitás instalación, revisión o mantenimiento de artefactos, revisá <a href="/servicios/gas/">gasista en Pinamar</a>.</p></article>
            </div>
          </div>
        </section>
      </div>
    </section>
  </main>
  <Footer />
  <a class="floating-wa" href={whatsapp} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><Icon name="whatsapp" size={25} /></a>
</BaseLayout>
